FROM golang:1.26-alpine AS builder

WORKDIR /app

# 安装依赖
RUN apk add --no-cache git

# 复制 go.mod 和 go.sum
COPY go.mod go.sum ./
ENV GOTOOLCHAIN=auto
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# 复制源代码
COPY . .

# 编译 API 服务
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /cscan-api ./api/cscan.go

# 下载 nuclei-templates 作为兜底（构建时网络通畅）
RUN git clone --depth 1 https://github.com/projectdiscovery/nuclei-templates.git /nuclei-templates && \
    rm -rf /nuclei-templates/.git

# 运行镜像
FROM alpine:3.19

WORKDIR /app

# ca-certificates / tzdata 为运行时基础依赖
RUN apk add --no-cache ca-certificates tzdata

# 复制默认规则目录（黑名单/指纹/HTTP 映射/扫描模板/字典）
COPY rules/ ./rules/

# 复制预下载的 nuclei-templates（兜底模板）
COPY --from=builder /nuclei-templates /app/nuclei-templates-builtin

# 设置时区
ENV TZ=Asia/Shanghai

# 复制编译产物
COPY --from=builder /cscan-api .
COPY docker/cscan-api.yaml ./etc/cscan-api.yaml
COPY docker/entrypoint.sh ./

RUN chmod +x ./entrypoint.sh

EXPOSE 8888

ENTRYPOINT ["./entrypoint.sh"]
CMD ["./cscan-api", "-f", "etc/cscan-api.yaml"]
