# ============================================================================
# CSCAN 部署环境变量
#
# 【零配置部署】不需要本文件也能起：直接 `docker compose up -d`，
#   compose 内已为所有密钥内置默认值（见 docker-compose.yaml 的 ${VAR:-默认值}）。
#
# 【生产部署】务必覆盖默认值，避免使用公开已知的弱密钥：
#   cp .env.example .env   然后填入强随机值
# 强随机值生成：openssl rand -hex 16  (或 -hex 32 给 JWT)
# ============================================================================

# ----------------------------------------------------------------------------
# 密钥项（留空/不设置时走 compose 内置默认值，生产环境必须覆盖）
# ----------------------------------------------------------------------------

# JWT 签名密钥：多副本部署时所有 API 实例必须使用同一密钥，否则 token 互不认。
# 生成：openssl rand -hex 32
# 未设置时，单实例下 entrypoint 会自动生成随机密钥并持久化到 volume（多副本不可用此模式）。
CSCAN_JWT_SECRET=

# MongoDB root 用户名 / 密码：用于初始化 admin 库的超级账号，
# API 与 Worker 通过该账号连接（authSource=admin）。
# 默认值：cscan / cscan_default_mongo_pass（Mongo 端口不对外发布，仅内部网络可达）
CSCAN_MONGO_ROOT_USERNAME=cscan

# MongoDB root 密码：生成 openssl rand -hex 16
CSCAN_MONGO_ROOT_PASSWORD=

# Redis 访问密码：API 与 Worker 共用。生成 openssl rand -hex 16
# 默认值：cscan_default_redis_pass（Redis 端口不对外发布，仅内部网络可达）
CSCAN_REDIS_PASSWORD=

# Worker Install Key：Worker 注册认证密钥（X-Worker-Key 头）。
# 默认 Worker 节点与手动部署的探针都用它。生成 openssl rand -hex 16
# 默认值：cscan_default_worker_key
# 注意：API 的 8888 端口对外发布，若服务暴露在公网，此项必须覆盖，
#       否则任何人都能用默认 key 注册 Worker 节点。
CSCAN_WORKER_KEY=

# 注意：修改 Mongo 账号密码后需要 `docker compose down -v` 清空 cscan_mongodb_data
#       卷才会重新初始化（Mongo 仅在数据目录为空时读取 MONGO_INITDB_ROOT_* 变量）。

# ----------------------------------------------------------------------------
# 可选项（带默认值，通常无需修改）
# ----------------------------------------------------------------------------

# MongoDB 数据库名（需与 CSCAN_MONGO_URI 中的库名一致）
# CSCAN_MONGO_DB=cscan

# Worker 单节点并发数：留空则按容器内存上限自适应（1~16），低配防 OOM、高配提吞吐
# CSCAN_CONCURRENCY=

# Worker 单条日志最大字节数（超长内容截断，防日志膨胀）
# CSCAN_WORKER_LOG_MAX_CONTENT_LENGTH=4096
