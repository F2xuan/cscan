# ============ 编译阶段 ============
# 使用 Debian 基础镜像，便于 ksubdomain 的 CGO+libpcap 与运行时 glibc 兼容
FROM golang:1.26-bookworm AS builder

ARG VERSION

WORKDIR /app

# 安装编译依赖（libpcap-dev 给 ksubdomain CGO 用）
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl libpcap-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# 国内网络优先用 goproxy.cn，回落到 direct，避免容器内访问 proxy.golang.org 失败
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=off

# 复制依赖文件并下载
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# 复制源代码
COPY . .

# 下载 ip2region 数据库（编译时准备，网络失败不影响构建，运行时按需降级）
RUN mkdir -p /app/data && \
    (curl -sL --connect-timeout 10 --max-time 60 "https://github.com/lionsoul2014/ip2region/raw/master/data/ip2region_v4.xdb" -o /app/data/ip2region_v4.xdb || true) && \
    (curl -sL --connect-timeout 10 --max-time 60 "https://github.com/lionsoul2014/ip2region/raw/master/data/ip2region_v6.xdb" -o /app/data/ip2region_v6.xdb || true) && \
    ls -la /app/data/

# 编译 worker（纯 Go 静态二进制）
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.Version=${VERSION}" \
        -o /cscan-worker ./worker/main.go

# 安装 ksubdomain（需要 CGO+libpcap，与运行时同 libc）
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go install -v github.com/boy-hack/ksubdomain/v2/cmd/ksubdomain@latest

# 安装 CLI 扫描工具（固定版本，可重现构建）
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.11.1 && \
    CGO_ENABLED=1 go install -v github.com/projectdiscovery/httpx/cmd/httpx@v1.10.0 && \
    CGO_ENABLED=1 go install -v github.com/projectdiscovery/naabu/v2/cmd/naabu@v2.6.1 && \
    CGO_ENABLED=1 go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.15.0 && \
    CGO_ENABLED=0 go install -v github.com/ffuf/ffuf/v2@v2.2.1 && \
    CGO_ENABLED=1 go install -v github.com/praetorian-inc/fingerprintx/cmd/fingerprintx@v1.1.19 && \
    CGO_ENABLED=1 go install -v github.com/projectdiscovery/dnsx/cmd/dnsx@v1.3.0

# 下载 feroxbuster 预编译二进制（Rust 工具，非 go install）
RUN curl -sL "https://github.com/epi052/feroxbuster/releases/latest/download/x86_64-linux-feroxbuster.tar.gz" -o /tmp/feroxbuster.tar.gz && \
    tar -xzf /tmp/feroxbuster.tar.gz -C /tmp && \
    chmod +x /tmp/feroxbuster && \
    rm -f /tmp/feroxbuster.tar.gz

# ============ 运行阶段 ============
FROM debian:bookworm-slim

# 运行时依赖：nmap 在 Debian 是单包齐全（自带 nse_main.lua 与 NSE 脚本），无需 NMAPDIR 环境变量
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        nmap \
        masscan \
        chromium \
        fonts-noto-cjk \
        util-linux \
        libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

# 构建期 fail-fast：确认 nmap NSE 引擎入口与脚本目录都在
RUN test -f /usr/share/nmap/nse_main.lua \
    && test -d /usr/share/nmap/scripts \
    && nmap --version | head -1

# 设置时区
ENV TZ=Asia/Shanghai
# chromedp 截图引擎通过 CHROME_BIN 定位系统 Chromium
ENV CHROME_BIN=/usr/bin/chromium

# 复制 ip2region 数据库
COPY --from=builder /app/data ./data/

# 复制二进制文件
COPY --from=builder /cscan-worker /cscan-worker
COPY --from=builder /go/bin/ksubdomain /usr/local/bin/ksubdomain
COPY --from=builder /go/bin/nuclei /usr/local/bin/nuclei
COPY --from=builder /go/bin/httpx /usr/local/bin/httpx
COPY --from=builder /go/bin/naabu /usr/local/bin/naabu
COPY --from=builder /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=builder /go/bin/ffuf /usr/local/bin/ffuf
COPY --from=builder /tmp/feroxbuster /usr/local/bin/feroxbuster
COPY --from=builder /go/bin/fingerprintx /usr/local/bin/fingerprintx
COPY --from=builder /go/bin/dnsx /usr/local/bin/dnsx

# 启动脚本（prlimit 提升 fd 上限）
RUN printf '#!/bin/sh\nexec prlimit --nofile=65535:65535 /cscan-worker "$@"\n' > /start.sh \
    && chmod +x /start.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep cscan-worker || exit 1

ENTRYPOINT ["/start.sh"]
